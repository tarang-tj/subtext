# Subtext uses a free-tier model key by default so that anyone can run this
# without a billing account. Get one in about a minute:
#
#   https://aistudio.google.com/apikey
#
# Copy this file to .env.local and paste your key below.

GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# Optional alternative provider. If GEMINI_API_KEY is absent and this is set,
# Subtext uses Anthropic instead. See src/lib/llm/provider.ts.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
