# Subtext uses a free-tier model key by default so that anyone can run this
# without a billing account. Copy this file to .env.local and add one key.
#
# The key is read only in src/lib/llm/provider.ts, which carries a `server-only`
# import so the build fails rather than shipping it to a browser. Nothing here is
# prefixed NEXT_PUBLIC_, and .env.local is gitignored.

# Preferred. Free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Must be a model that supports response_format json_schema.
# llama-3.3-70b-versatile does NOT. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Alternatives, used in this order if GROQ_API_KEY is absent.
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
